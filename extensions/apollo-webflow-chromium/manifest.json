{
  "manifest_version": 3,
  "name": "Apollo WebFlow",
  "version": "2.0.1",
  "key": "",
  "description": "Private numeric navigation and interaction telemetry for local Apollo acceleration.",
  "permissions": [
    "nativeMessaging",
    "storage",
    "webNavigation",
    "scripting"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Enable Apollo WebFlow vitals"
  }
}