<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.eduardocortez.apollo-context-agent</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/libexec/apollo-context-agent</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>APOLLO_SOCKET_PATH</key>
        <string>/var/run/apollo-optimizer.sock</string>
    </dict>

    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
</dict>
</plist>
